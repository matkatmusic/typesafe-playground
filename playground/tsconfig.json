{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "lib": ["ES2022", "DOM"],
        "types": ["bun"],
        "jsx": "react",
        "jsxFactory": "h",
        "jsxFragmentFactory": "Fragment"
    },
    // "include": ["*.ts", "server/**/*.ts", "providers/**/*.ts", "history/**/*.ts", "startup/**/*.ts", "shared/**/*.ts"],
    "include": ["*.ts", "server/**/*.ts", "providers/**/*.ts", "history/**/*.ts", "startup/**/*.ts", "shared/**/*.ts", "page/**/*.ts", "page/**/*.tsx"],
    "exclude": []
}
